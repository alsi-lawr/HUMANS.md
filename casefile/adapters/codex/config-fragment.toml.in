[features]
multi_agent = __CASEFILE_MULTI_AGENT_V1__
multi_agent_v2 = __CASEFILE_MULTI_AGENT_V2__

[mcp_servers.casefile]
command = __CASEFILE_EXECUTABLE__
args = ["mcp-package", "--planning-root", __CASEFILE_PLANNING_ROOT__]

[agents]
max_depth = 2
max_threads = 6

[agents.casefile-implement-ticket-batch-implementation-writer]
description = "Casefile casefile-implement-ticket-batch implementation-writer."
config_file = "__HUMANS_MD_PLUGIN_ROOT__/agents/casefile-implement-ticket-batch-implementation-writer.toml"
nickname_candidates = ["Builder", "Implementer"]

[agents.casefile-implement-ticket-batch-atomic-ticket-reviewer]
description = "Casefile casefile-implement-ticket-batch atomic-ticket-reviewer."
config_file = "__HUMANS_MD_PLUGIN_ROOT__/agents/casefile-implement-ticket-batch-atomic-ticket-reviewer.toml"
nickname_candidates = ["Reviewer", "Auditor"]

[agents.casefile-implement-ticket-batch-verification-reviewer]
description = "Casefile casefile-implement-ticket-batch verification-reviewer."
config_file = "__HUMANS_MD_PLUGIN_ROOT__/agents/casefile-implement-ticket-batch-verification-reviewer.toml"
nickname_candidates = ["Verifier", "Checker"]

[agents.casefile-implement-pipeline-implementation-writer]
